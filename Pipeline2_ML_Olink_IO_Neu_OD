# DEFINE THE FUNCTION
plot_cm <- function(cm, title, acc, subtitle = "", palette = "train") {
  m <- as.data.frame(cm$table)
  colnames(m) <- c("Predicted","True","Freq")
  
  ggplot(m, aes(Predicted, True, fill = Freq)) +
    geom_tile(color = "white", linewidth = 1.2) +
    geom_text(aes(label = Freq), color = "black", # Changed to black for better visibility on green
              size = 8, fontface = "bold") +
    scale_fill_gradient(
      low = "#e8f5e9", # Light Green
      high = "#2e7d32", # Dark Forest Green
      guide = guide_colourbar(
        barheight = unit(15, "lines"),
        barwidth = unit(1, "lines"),
        ticks.colour = "black",
        frame.colour = "black"
      )
    ) +
    labs(
      title = paste0(title, " (Accuracy = ", acc, ")"),
      subtitle = subtitle,
      x = "Predicted label",
      y = "True label",
      fill = NULL
    ) +
    theme_minimal(base_size = 18) +
    theme(
      plot.title = element_text(size = 16, face = "bold", hjust=0.5),
      plot.subtitle = element_text(size = 12, face = "italic", color = "gray20"),
      axis.text = element_text(color="black", size = 16),
      legend.title = element_blank(),
      legend.text = element_text(size = 14)
    )
}


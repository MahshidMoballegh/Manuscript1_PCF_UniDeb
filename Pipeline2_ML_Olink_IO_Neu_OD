cv_import_cns <- matrix(NA_real_, nrow = length(feat_names), ncol = k, dimnames = list(feat_names, paste0("Fold", 1:k)))

for (i in 1:k) {
  train_i <- df_cv_cns[folds != i, ] 
  test_i  <- df_cv_cns[folds == i, ]
  rf_i <- randomForest(as.formula(paste(target_col_cns, "~ .")), data = train_i, importance = TRUE)
  pred_i <- predict(rf_i, newdata = test_i)
  acc_i <- mean(pred_i == test_i[[target_col_cns]])
  
  run_name <- paste0("Fold", i)
  cv_models_cns[[run_name]] <- rf_i
  cv_acc_cns[run_name] <- acc_i
  cv_conf_cns[run_name] <- list(table(Truth = test_i[[target_col_cns]], Pred = pred_i))
  
  if (!is.null(rf_i$importance)) {
    common_feats <- intersect(feat_names, rownames(rf_i$importance))
    cv_import_cns[common_feats, run_name] <- rf_i$importance[common_feats, "MeanDecreaseGini"]
  }
}


# FUNCTION DEFINITION 
run_svm_bootstrap <- function(list_of_prots, data, n_boot = 1000) {
  final_res <- data.frame()
  
  for (group_name in names(list_of_prots)) {
    p <- list_of_prots[[group_name]]
    if(length(p) == 0) next
    
    boot_aucs <- numeric(n_boot)
    cat("Processing Group:", group_name, "\n")
    
    for (i in 1:n_boot) {
      # Sampling with replacement
      idx <- sample(1:nrow(data), replace = TRUE)
      train_set <- data[idx, ]
      oob_idx <- setdiff(1:nrow(data), unique(idx))
      test_set <- data[oob_idx, ]
      
      if(length(unique(test_set$Visitcode)) < 2) {
        boot_aucs[i] <- NA
        next
      }
      
      # SVM Radial Model
      svm_fit <- e1071::svm(as.factor(Visitcode) ~ ., 
                            data = train_set[, c(p, "Visitcode")], 
                            kernel = "radial", 
                            probability = TRUE)
      
      # OOB Prediction
      pred <- predict(svm_fit, test_set[, p], probability = TRUE)
      probs <- attr(pred, "probabilities")
      
      # Get probabilities for the target class (e.g., "VD")
      pos_class <- levels(as.factor(data$Visitcode))[2]
      prob_scores <- probs[, pos_class]
      
      boot_aucs[i] <- as.numeric(pROC::roc(test_set$Visitcode, prob_scores, quiet = TRUE)$auc)
    }
    
    valid_aucs <- boot_aucs[!is.na(boot_aucs)]
    final_res <- rbind(final_res, data.frame(
      Group = group_name,
      N = length(p),
      Mean_OOB_AUC = round(mean(valid_aucs), 3),
      SD_AUC = round(sd(valid_aucs), 3),
      CI_Lower = round(quantile(valid_aucs, 0.025), 3),
      CI_Upper = round(quantile(valid_aucs, 0.975), 3),
      Proteins = paste(sort(p), collapse = ", ")
    ))
  }
  return(final_res)
}


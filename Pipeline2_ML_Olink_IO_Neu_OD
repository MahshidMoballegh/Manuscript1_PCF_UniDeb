# FUNCTION DEFINITION (Stratified for CNS_Target)
run_svm_bootstrap <- function(list_of_prots, data, n_boot = 1000) {
  final_res <- data.frame()
  
#  Ensure target is a strict factor with standard compliance
  data$CNS_Target <- factor(data$CNS_Target)
  levs <- levels(data$CNS_Target)
  pos_class <- make.names(levs[2])
  levels(data$CNS_Target) <- make.names(levs)
  
  for (group_name in names(list_of_prots)) {
    p <- list_of_prots[[group_name]]
    if(length(p) == 0) next
    
    boot_aucs <- numeric(n_boot)
    cat("Processing Group (VD):", group_name, "\n")
    
# Separate indices by class for stratified sampling
    idx_class1 <- which(data$CNS_Target == levels(data$CNS_Target)[1])
    idx_class2 <- which(data$CNS_Target == levels(data$CNS_Target)[2])
    
    set.seed(12345)
    for (i in 1:n_boot) {
# STRATIFIED SAMPLING - Sample within each class separately
      train_idx1 <- sample(idx_class1, replace = TRUE)
      train_idx2 <- sample(idx_class2, replace = TRUE)
      train_idx  <- c(train_idx1, train_idx2)
      
      train_set <- data[train_idx, ]
      oob_idx   <- setdiff(1:nrow(data), unique(train_idx))
      test_set  <- data[oob_idx, ]
      
#  Safety check to guarantee both classes exist in OOB
      if(length(unique(test_set$CNS_Target)) < 2) {
        missing_from_oob <- setdiff(1:nrow(data), oob_idx)
        extra_1 <- sample(intersect(missing_from_oob, idx_class1), 1)
        extra_2 <- sample(intersect(missing_from_oob, idx_class2), 1)
        test_set <- rbind(test_set, data[c(extra_1, extra_2), ])
      }
      
# SVM Radial Model
      svm_fit <- e1071::svm(CNS_Target ~ ., 
                            data = train_set[, c(p, "CNS_Target")], 
                            kernel = "radial", 
                            probability = TRUE)
      
# OOB Prediction
      pred <- predict(svm_fit, test_set[, p], probability = TRUE)
      probs <- attr(pred, "probabilities")
      prob_scores <- probs[, pos_class]
      
# Calculate OOB AUC safely
      roc_obj <- tryCatch(pROC::roc(test_set$CNS_Target, prob_scores, quiet = TRUE), error = function(e) NULL)
      if(!is.null(roc_obj)) {
        boot_aucs[i] <- as.numeric(roc_obj$auc)
      } else {
        boot_aucs[i] <- NA
      }
    }
    
    valid_aucs <- boot_aucs[!is.na(boot_aucs)]
    if(length(valid_aucs) == 0) valid_aucs <- c(0.5)
    
    final_res <- rbind(final_res, data.frame(
      Group = group_name,
      N = length(p),
      Mean_OOB_AUC = round(mean(valid_aucs), 3),
      SD_AUC = round(sd(valid_aucs), 3),
      CI_Lower = round(quantile(valid_aucs, 0.025), 3),
      CI_Upper = round(quantile(valid_aucs, 0.975), 3),
      Proteins = paste(sort(p), collapse = ", ")
    ))
  }
  return(final_res)
}



# 5-fold Cross-Validation for Visitcode
set.seed(1234)

# Assuming imp_Visitcode_df_top30$Feature contains the names
top_features <- imp_Visitcode_df_top30$Feature

# This filters out the 'noise' from other proteins
target_col_vc <- "Visitcode"
df_cv_vc <- rf_data_Visitcode[, c(target_col_vc, top_features)]

k <- 5
n <- nrow(df_cv_vc)

# Create stratified folds to ensure balanced classes
folds <- integer(n)
cls <- df_cv_vc[[target_col_vc]]

for (lev in levels(cls)) {
  idx <- which(cls == lev)
  idx <- sample(idx, length(idx), replace = FALSE)
  grp_ids <- rep(1:k, length.out = length(idx))
  folds[idx] <- grp_ids
}

# Identify feature names (proteins/assays)
feat_names <- setdiff(colnames(df_cv_vc), target_col_vc)

# Initialize storage for results
cv_models_vc <- vector("list", k)
cv_acc_vc <- numeric(k)
cv_conf_vc <- vector("list", k)
names(cv_models_vc) <- names(cv_acc_vc) <- names(cv_conf_vc) <- paste0("Fold", 1:k)

# Matrix to store Gini importance for each fold
cv_import_vc <- matrix(NA_real_, nrow = length(feat_names), ncol = k,
                       dimnames = list(feat_names, paste0("Fold", 1:k)))

cat("Starting 5-fold CV for Visitcode (Random Forest)\n")

for (i in 1:k) {
  # Standard CV: Train on 4 folds, Test on 1 fold
  train_i <- df_cv_vc[folds != i, ] 
  test_i  <- df_cv_vc[folds == i, ]
  
  # Train Random Forest model for Visitcode
  rf_i <- randomForest(
    as.formula(paste(target_col_vc, "~ .")),
    data = train_i,
    importance = TRUE
  )
  
  # Predict on the hold-out fold
  pred_i <- predict(rf_i, newdata = test_i)
  
  # Calculate fold accuracy
  acc_i <- mean(pred_i == test_i[[target_col_vc]])
  
  run_name <- paste0("Fold", i)
  cv_models_vc[[run_name]] <- rf_i
  cv_acc_vc[run_name] <- acc_i
  cv_conf_vc[run_name] <- list(table(Truth = test_i[[target_col_vc]], Pred = pred_i))
  
  # Extract MeanDecreaseGini
  if (!is.null(rf_i$importance)) {
    common_feats <- intersect(feat_names, rownames(rf_i$importance))
    cv_import_vc[common_feats, run_name] <- rf_i$importance[common_feats, "MeanDecreaseGini"]
  }
  cat(sprintf("\n %s Result: Accuracy = %.3f\n", run_name, acc_i))
  print(cv_conf_vc[[run_name]])
}
write.csv(cv_import_vc, file = file.path(rf_dir, "RF_CV_Importance_Per_Fold.csv"))
# Create a summary table for the accuracy of each fold
cv_res_df <- data.frame(Fold = names(cv_acc_vc), Accuracy = as.numeric(cv_acc_vc))
# Add the average accuracy across all folds to the summary table
cv_res_df <- rbind(cv_res_df, data.frame(Fold = "Average", Accuracy = mean(cv_acc_vc)))
# Save the accuracy results to a CSV file in the RF directory
write.csv(cv_res_df, file = file.path(rf_dir, "RF_CV_Accuracy.csv"), row.names = FALSE)
# Export the Confusion Matrix of all folds into a text file for detailed error analysis
sink(file.path(rf_dir, "RF_CV_Confusion_Matrices.txt"))
cat("Confusion Matrices for Each Fold\n")
print(cv_conf_vc)
sink()
cat("\nOverall mean accuracy across 5 folds (Visitcode):\n")

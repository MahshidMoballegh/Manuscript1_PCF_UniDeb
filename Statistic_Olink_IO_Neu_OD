    Group_CNS_Involvement %in% c(2, 3) ~ "2+3",
    TRUE ~ as.character(Group_CNS_Involvement)
  ))

#***************************
#      PARAMETERS
#***************************
FC_THRESHOLD <- 0.5
Q_THRESHOLD  <- 0.05  
P_THRESHOLD  <- 0.05

#***************************
#      DIRECTORIES 
#***************************
ROOT_DIR <- "CNS1 vs 2+3 (VR)"
DIR_TABLES   <- file.path(ROOT_DIR, "Tables")
DIR_VOLCANO  <- file.path(ROOT_DIR, "Volcano_Plots")
DIR_BOXPLOT  <- file.path(ROOT_DIR, "Boxplots")
DIR_HEATMAP  <- file.path(ROOT_DIR, "Heatmaps")

dir.create(ROOT_DIR, showWarnings = FALSE)
dir.create(DIR_TABLES, showWarnings = FALSE)
dir.create(DIR_VOLCANO, showWarnings = FALSE)
dir.create(DIR_BOXPLOT, showWarnings = FALSE)
dir.create(DIR_HEATMAP, showWarnings = FALSE)

#***************************
#    CORE FUNCTION
#***************************
run_comparison <- function(df, group_col, g1, g2, label){
  
  res <- lapply(assays, function(a){
    x <- df %>% filter(.data[[group_col]] == g1) %>% pull(a) %>% na.omit()
    y <- df %>% filter(.data[[group_col]] == g2) %>% pull(a) %>% na.omit()
    
    if(length(x) < 2 | length(y) < 2) return(NULL)
    
    wt <- wilcox.test(x, y, exact = FALSE, correct = FALSE)
    
    data.frame(
      Assay = a,
      pvalue = wt$p.value,
      Log2FC = median(x) - median(y)
    )
  })
  
  res <- bind_rows(res)
  
  
# Q-VALUE CALCULATION
  
  if(nrow(res) > 1){
    res$qvalue <- tryCatch({
# Using qvalue package for more accurate FDR estimation in Omics data
      qobj <- qvalue::qvalue(res$pvalue)
      qobj$qvalues
    }, error = function(e) {
# Fallback to standard FDR if qvalue fails (e.g., due to low sample size/flat distribution)
      message("qvalue failed, falling back to p.adjust (FDR)")
      p.adjust(res$pvalue, method = "fdr")
    })
  } else {
    res$qvalue <- res$pvalue
    
  }
  
  write.csv(res, file.path(DIR_TABLES, paste0(label, ".csv")), row.names = FALSE)
  
#***************************
#  VOLCANO (Q-VALUE BASED)
 #**************************
 
   plot_df <- res %>%
    mutate(
      status = case_when(
        qvalue < Q_THRESHOLD & Log2FC > FC_THRESHOLD  ~ "Increased",
        qvalue < Q_THRESHOLD & Log2FC < -FC_THRESHOLD ~ "Decreased",
        TRUE ~ "Not Significant"
      ),
      label_text = ifelse(status != "Not Significant", Assay, NA)
    )
  
  p <- ggplot(plot_df, aes(Log2FC, -log10(qvalue), color = status)) +
    geom_jitter(data = filter(plot_df, status == "Not Significant"), 
                width = 0.1, height = 0.05, alpha = 0.7, size = 2, color = "gray10") +
    geom_point(data = filter(plot_df, status != "Not Significant"), size = 3, alpha = 0.8) +
    geom_text_repel(aes(label = label_text), max.overlaps = 10, size=6) +
    geom_vline(xintercept = c(-FC_THRESHOLD, FC_THRESHOLD), linetype = "dotted") +
    geom_hline(yintercept = -log10(Q_THRESHOLD), linetype = "dashed") +
    scale_color_manual(values = c("Increased"="red",
                                  "Decreased"="blue"),
                       breaks = c("Increased", "Decreased")) +
    theme_bw() +
    labs(title = label, x = "Log2 Fold Change", y = "-log10(q-value)") +
    theme(legend.title = element_blank(),
          text = element_text(family = "Arial", face = "plain"),
          legend.text = element_text(size = 18),
          plot.title = element_text(hjust = 0.5, size = 18),
          axis.title = element_text(size = 18),
          axis.text = element_text(color = "black", size = 18),
          panel.grid.major = element_blank(),
          panel.grid.minor = element_blank(),
          panel.border = element_rect(color = "black", fill = NA)
    )
  ggsave(file.path(DIR_VOLCANO, paste0(label, "_volcano.png")),
         p, width = 8, height = 6)
  
#***************************
#  SIGNIFICANT PROTEINS
#***************************
  sig_prots <- plot_df %>%
    filter(status != "Not Significant") %>%
    pull(Assay)
  
  if(length(sig_prots) == 0) return(NULL)
  
#***************************
#        BOXPLOTS
#***************************
  long_df <- df %>%
    filter(.data[[group_col]] %in% c(g1, g2)) %>%
    select(PatientID, all_of(group_col), all_of(sig_prots)) %>%
    pivot_longer(-c(PatientID, all_of(group_col)),
                 names_to = "Protein",
                 values_to = "NPX")
  
  bp <- ggplot(long_df,
               aes(.data[[group_col]], NPX, fill = .data[[group_col]])) +
    geom_boxplot(outlier.shape = NA) +
    geom_jitter(width = 0.2, size = 1, alpha = 0.6) +
    facet_wrap(~Protein, scales = "free_y") +
    theme_bw() +
    theme(axis.text.x = element_text(angle = 45, hjust = 1),
          legend.position = "none") +
    labs(y = "Protein abundance (NPX)", x = "Group")
  
  ggsave(file.path(DIR_BOXPLOT, paste0(label, "_boxplot.png")),
         bp, width = 12, height = 7)
  
#***************************
#     HEATMAP
#***************************

#Preparing the matrix and generating expression heatmap for VR significant proteins
  heat_df <- df %>%
    filter(.data[[group_col]] %in% c(g1, g2)) %>%
    select(PatientID, all_of(group_col), all_of(sig_prots)) %>%
    mutate(SampleID = paste(PatientID, .data[[group_col]], sep = "_"))
  
  mat <- heat_df %>%
    select(-PatientID, -all_of(group_col)) %>%
    column_to_rownames("SampleID") %>%
    as.matrix() %>%
    t()
  
  mat <- mat[
    apply(mat, 1, function(x) sd(x, na.rm = TRUE) > 0),
    ,
    drop = FALSE
  ]
  
  sample_info <- heat_df %>%
    filter(SampleID %in% colnames(mat)) %>%
    arrange(.data[[group_col]])
  
  mat <- mat[, sample_info$SampleID, drop = FALSE]
  
  annotation_col <- data.frame(
    Group = sample_info[[group_col]]
  )
  rownames(annotation_col) <- sample_info$SampleID
  
  if (nrow(mat) < 2 || ncol(mat) < 2) return(NULL)
  
  file_path_heatmap <- file.path(DIR_HEATMAP, paste0(label, "_heatmap.png"))
  
  pheatmap(
    mat,
    scale = "row",
    color = colorRampPalette(c("blue", "white", "red"))(100),
    annotation_col = annotation_col,
    fontsize_row = 8,
    fontsize_col = 7,
    angle_col = "90",
    main = label,
    border_color = NA,
    cluster_rows = FALSE,
    cluster_cols = FALSE,
    filename = file_path_heatmap,
    width = 10,
    height = 7
  )
}

